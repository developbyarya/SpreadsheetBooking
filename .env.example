# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Production / development URL
APP_URL="https://spreadsheet-booking.vercel.app"

# EMAIL_BYPASS: Set to "true" to test without sending emails (bypasses email verification)
EMAIL_BYPASS="true"
VITE_EMAIL_BYPASS="true"

# GOOGLE_SERVICE_ACCOUNT_KEY: Entire Google Service Account JSON string for 24/7 Sheets write
# GOOGLE_SERVICE_ACCOUNT_KEY='{"type":"service_account",...}'

# SPREADSHEET_ID: Target default presentation spreadsheet ID
SPREADSHEET_ID="1y9ikk1kCJZsmrO8w5YQEXN8BFtensg8R8AcTo7xtQjQ"
DEFAULT_SHEET_NAME="Progress 2"
DEFAULT_START_ROW="59"

# EMAIL PROVIDER OPTIONS (Choose Resend OR Gmail/SMTP):
# Option A: Resend API (recommended)
# RESEND_API_KEY="re_..."
# RESEND_FROM="SlotSync <onboarding@resend.dev>"

# Option B: Gmail SMTP
# GMAIL_USER="your-email@gmail.com"
# GMAIL_APP_PASSWORD="16-character-app-password"
